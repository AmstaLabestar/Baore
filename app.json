{
  "expo": {
    "name": "Baore",
    "slug": "baore",
    "version": "1.0.0",
    "scheme": "baore",
    "orientation": "portrait",
    "icon": "./assets/Baore.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Baore.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.amstalabestar.baore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Baore.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ecc26ea-75a9-48f2-abdc-22aa3cec6beb"
      }
    },
    "owner": "bikienga_hamza"
  }
}
